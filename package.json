{
  "name": "@swarmmachina/benchkit",
  "version": "0.2.0",
  "description": "Zero-dependency TypeScript helpers for SwarmMachina benchmarks",
  "keywords": [
    "benchmark",
    "performance",
    "profiling",
    "typescript",
    "swarmmachina",
    "zero-dependency"
  ],
  "author": "SwarmMachina Team",
  "license": "MPL-2.0",
  "type": "module",
  "bin": {
    "benchkit-agent": "./dist/agent/cli.js"
