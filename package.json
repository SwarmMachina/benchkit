  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SwarmMachina/benchkit.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "prettier": "@swarmmachina/standards/prettier",
  "swmStandards": {
    "preset": "typescript"
  },
  "scripts": {
    "bench:http1-load": "pnpm build && node scripts/benchmark-http1-load.js",
    "build": "node scripts/clean-dist.js && tsc",
    "check": "swm-standards check && tsc --noEmit && node scripts/check-public-type-docs.js",
    "check:type-docs": "node scripts/check-public-type-docs.js",
    "check:types": "tsc --noEmit",
    "fix": "swm-standards fix",
    "test": "node scripts/clean-dist.js && tsc && tsc -p tsconfig.package-test.json && node scripts/run-tests.js",
    "test:unit": "node scripts/clean-dist.js && tsc && tsc -p tsconfig.package-test.json && node scripts/run-tests.js unit",
    "test:integration": "node scripts/clean-dist.js && tsc && node scripts/run-tests.js integration",
    "test:packed-types": "pnpm build && node scripts/test-packed-types.js",
    "release:verify-tag": "node scripts/verify-release.js",
    "release:verify-published": "node scripts/verify-published.js",
    "release:publish": "node scripts/publish-release.js",
    "release:gate": "node scripts/release-gate.js",
    "prepublishOnly": "node scripts/release-gate.js"
  },
  "devDependencies": {
    "@swarmmachina/standards": "3.0.0",
    "@types/node": "24.10.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.65.0"
  }
}
